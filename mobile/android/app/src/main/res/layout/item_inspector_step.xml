<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_step"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginEnd="@dimen/spacing_16"
    android:layout_marginTop="@dimen/spacing_6"
    android:layout_marginBottom="@dimen/spacing_6"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/corner_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_separator"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/primary_surface"
    app:rippleColor="@color/ripple_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Row (Always Visible) -->
        <LinearLayout
            android:id="@+id/layout_step_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/spacing_16">

            <!-- Numbered Badge (Circle) -->
            <TextView
                android:id="@+id/text_step_number"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_step_badge"
                android:textColor="@color/primary_accent"
                tools:text="1" />

            <!-- Title & Summary -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_8"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_step_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:textColor="@color/primary_text"
                    tools:text="Tokenizer" />

                <TextView
                    android:id="@+id/text_step_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:fontFamily="sans-serif"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:ellipsize="end"
                    android:singleLine="true"
                    tools:text="Compiled C-Regex: 2 tokens extracted" />
            </LinearLayout>

            <!-- Latency Pill -->
            <TextView
                android:id="@+id/text_step_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_4"
                android:paddingBottom="@dimen/spacing_4"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/secondary_text"
                tools:text="31.7 µs" />

            <!-- Chevron Expand/Collapse Indicator -->
            <ImageView
                android:id="@+id/icon_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/spacing_8"
                android:contentDescription="@string/tab_inspector"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/secondary_text" />
        </LinearLayout>

        <!-- Divider line when expanded -->
        <View
            android:id="@+id/step_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_separator"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Expanded Detail Container (Populated Programmatically) -->
        <LinearLayout
            android:id="@+id/layout_step_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16"
            android:background="@color/secondary_surface"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Title in Inspector -->
            <TextView
                android:id="@+id/text_step_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:textColor="@color/primary_accent"
                android:layout_marginBottom="@dimen/spacing_8"
                tools:text="1. Query Input &amp; Positional Tokenizer" />

            <!-- Dynamic Fields Container -->
            <LinearLayout
                android:id="@+id/container_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
